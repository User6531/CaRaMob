<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" Sdk="Microsoft.Docker.Sdk">
  <PropertyGroup Label="Globals">
    <ProjectVersion>2.1</ProjectVersion>
    <DockerTargetOS>Linux</DockerTargetOS>
    <ProjectGuid>{C1D2E3F4-A5B6-4890-CDEF-012345678901}</ProjectGuid>
    <DockerLaunchAction>LaunchBrowser</DockerLaunchAction>
    <DockerServiceUrl>{Scheme}://localhost:{ServicePort}/swagger</DockerServiceUrl>
    <DockerServiceName>mainhub-api</DockerServiceName>
  </PropertyGroup>
  <ItemGroup>
    <DockerComposeFiles Include="docker-compose.yml" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="MainHub.Api.csproj">
      <AdditionalProperties>ComposeServiceName=mainhub-api</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
